# Leave a key empty and that sponsor runs in mock mode. GUARDIAN_MOCK=1 forces everything to mock.
GUARDIAN_MOCK=0
PUBLIC_BASE_URL=https://YOUR-TUNNEL.trycloudflare.com
UI_BASE_URL=http://localhost:3000

# Daytona + Anchor (Hero 3: safe link opening)
DAYTONA_API_KEY=
ANCHOR_API_KEY=
DETONATE_MODE=quarantine       # quarantine (Anchor here, parse in a no-network Daytona sandbox) | daytona (needs Tier 3 egress) | local | mock
DETONATE_TIMEOUT_S=20

# ElevenLabs Agents + Twilio
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=    # the Twilio number imported into ElevenLabs
WARNING_AGENT_ID_ES=
WARNING_AGENT_ID_EN=
WARNING_AGENT_ID_TE=
VERIFY_AGENT_ID=
SECOND_KEY_AGENT_ID=
ELEVENLABS_VOICE_ID_ES=        # for the help voice note (TTS)
ELEVENLABS_VOICE_ID_EN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1
TWILIO_WHATSAPP_FROM=          # +14155238886 = Twilio WhatsApp sandbox; when set, every text goes over WhatsApp (delivers without A2P registration)
TEXT_BUDGET=0                  # cap on real texts sent (sandbox quota); 0 = unlimited. Screens always show every text.
TEXT_ESSENTIAL_ONLY=0          # 1 = send only texts a call doesn't cover (scam alert, key link, help note, suspicious, approved)
DEMO_LIVE=0                    # 0 = demo beats from the UI are always rehearsals (no texts/calls); 1 only for the real stage run
VERIFY_RETRY_AFTER_S=120       # set to 20 for the stage
ADMIN_ESCALATE_AFTER_S=900

# SurrealDB
SURREAL_URL=                   # http://localhost:8001
SURREAL_USER=root
SURREAL_PASS=root

# AWS
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=              # a Claude model id enabled for your account in Bedrock
USE_TEXTRACT=0

# Arize AX (cloud, preferred): app.arize.com -> Settings
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT=guardian
# Arize Phoenix (self-hosted fallback when ARIZE_* is empty)
PHOENIX_COLLECTOR_ENDPOINT=    # http://localhost:6006
PHOENIX_PROJECT=guardian

# SurrealDB Agent Memory (hosted): studio.surrealdb.com -> Agent Memory -> your context
SURREAL_MEMORY_URL=            # context host URL
SURREAL_MEMORY_KEY=            # sp-...
SURREAL_MEMORY_CONTEXT=        # context id

# Rehearsal without phones
MOCK_VERIFY_OUTCOME=denied     # denied | confirmed | no_answer
MOCK_KEY_DECISION=             # empty = wait for Daniel's screen; or decline | approve
MOCK_CALL_SPEED=1.0
KEY_ACCEPT_VERBAL=0            # 1 = Daniel saying 'don't send' on the call also keeps the money locked
INGEST_TOKEN=change-me        # shared secret the phone automation sends to /ingest
FAMILY_PHONE_JASMINE=          # real demo phones override data/seed_family.json (ids: jasmine, amma, rosa, daniel, ana)
FAMILY_PHONE_AMMA=
FAMILY_PHONE_ROSA=
FAMILY_PHONE_DANIEL=
FAMILY_PHONE_ANA=
FAMILY_WHATSAPP_JASMINE=       # only if WhatsApp is on a different number than calls (e.g. +91...)
FAMILY_WHATSAPP_AMMA=
FAMILY_WHATSAPP_DANIEL=
DAYTONA_SNAPSHOT=               # after: python scripts/make_daytona_snapshot.py -> guardian-detonator
